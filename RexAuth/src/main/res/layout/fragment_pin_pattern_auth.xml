<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/auth_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_lock"
            app:tint="?attr/colorPrimary" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            style="@style/TextAppearance.RexAuth.HeadlineSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:text="@string/pin_auth_title"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/subtitle"
            style="@style/TextAppearance.RexAuth.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:text="@string/pin_auth_subtitle"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/error_text"
            style="@style/TextAppearance.RexAuth.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <!-- PIN View -->
        <com.goodiebag.pinview.Pinview
            android:id="@+id/pin_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:pinBackground="@drawable/bg_pinview"
            app:pinLength="4" />

        <com.rexvit.rexauth.ui.PatternLockView
            android:id="@+id/pattern_view"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:plv_colorNormal="@color/pattern_normal"
            app:plv_colorCorrect="@color/pattern_correct"
            app:plv_colorWrong="@color/pattern_error"
            app:plv_dotCount="3"
            app:plv_pathWidth="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/forgot_button"
            style="@style/Widget.RexAuth.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="@string/forgot_pattern"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/use_biometric_button"
            style="@style/Widget.RexAuth.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/use_biometric"
            app:icon="@drawable/ic_fingerprint"
            app:iconGravity="textStart" />

    </LinearLayout>
</ScrollView>